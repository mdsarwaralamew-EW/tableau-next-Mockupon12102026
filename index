function render(){
 const A=agg();
 const att=pc(A.actual,A.target);
 const win=A.won+A.lost>0?A.won/(A.won+A.lost)*100:0;
 const arTot=A.ar.reduce((s,v)=>s+v,0);
 const ar90s=arTot>0?A.ar[3]/arTot*100:0;
 const coll=A.actual>0?A.cash/A.actual*100:0;
 const b2b=A.actual>0?A.intake/A.actual:0;
 const R0=reps();
 const remain=Math.max(R0.reduce((s,x)=>s+x.t,0)*12-R0.reduce((s,x)=>s+x.a,0)*6.5,.01);
 const cov=A.openPipe/remain;
 const avg=A.won>0?A.actual/A.won:0;
 const mtd=R0.reduce((s,x)=>s+x.a,0);
 const blc=mtd>0?A.backlog/mtd:0;
 const ccc=A.dso+A.dio-A.dpo;
 const gp=A.actual*A.gm/100;
 const cf=(ok,warn)=>ok?"g":warn?"a":"r";

 /* ── CASCADING FILTER WIDGETS ──
    Company narrows Managers, Salespeople and Brands. Manager narrows Salespeople to their team. */
 $("coSel").value=S.co;
 const mgrSet=MGRS.filter(m=>keys().includes(mgrCo(m)));
 const hasUnmapped=REPS.some(x=>keys().includes(x.c)&&x.mgr==="Not mapped");
 $("mgrSel").innerHTML=`<option value="all">All Managers${S.co==="all"?"":" — "+CO[S.co].short}</option>`
  +mgrSet.map(m=>`<option value="${m}">${m} · ${CO[mgrCo(m)].short}</option>`).join("")
  +(hasUnmapped?`<option value="Not mapped">Not mapped</option>`:"");
 if(S.mgr!=="all"&&S.mgr!=="Not mapped"&&!mgrSet.includes(S.mgr))S.mgr="all";
 if(S.mgr==="Not mapped"&&!hasUnmapped)S.mgr="all";
 $("mgrSel").value=S.mgr;

 let repSet=REPS.filter(x=>keys().includes(x.c));
 if(S.mgr!=="all")repSet=repSet.filter(x=>x.mgr===S.mgr);
 if(S.br!=="all")repSet=repSet.filter(x=>!x.brands||x.brands.includes(S.br));
