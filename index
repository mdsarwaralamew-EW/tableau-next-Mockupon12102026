/* ═══════════ METRIC PAGES ═══════════ */
function openMetric(id){
 const m=MET[id],v=MV[id]||{};
 $("mpN").textContent=m.n;
 $("mpS").textContent=`${S.co==="all"?"All companies":CO[S.co].name}${S.mgr!=="all"?" · "+S.mgr:""}${S.rep!=="all"?" · "+S.rep:""} · ${plb()}`;
 const col=v.r==="g"?"var(--green)":v.r==="a"?"var(--amber)":v.r==="r"?"var(--red)":"var(--tx)";
 const d=DLT[id];
 $("mpB").innerHTML=`
  <div class="hero">
   <div><div class="lab">Current value</div><div class="big" style="color:${col}">${v.v||"—"}</div></div>
   <div><div class="lab">vs prior period</div><div class="side">${d===undefined?"—":(d>0?'<span class="up">▲ '+d.toFixed(1)+'%</span>':d<0?'<span class="down">▼ '+Math.abs(d).toFixed(1)+'%</span>':'0.0%')}</div></div>
   <div><div class="lab">Reference</div><div class="side">${v.t||"—"}</div></div>
  </div>
  ${m.snap?`<div class="warn"><b>Snapshot metric.</b> Every Tableau Next metric needs a time dimension, and this one is a balance rather than a flow. Model it against a daily <b>Snapshot Date</b> built in Data 360, not a transaction date.</div>`:""}
  ${id==="openpipe"?`<div class="warn"><b>Stage rules differ by company.</b> Electric Way, Electric Way Arabia and Traderz count only Proposal and Finalizing. Hydroway's rule is an assumption pending your confirmation. Traderz stages are placeholders.</div>`:""}
  <div class="blk"><h4>What it shows</h4><p>${m.what}</p></div>
  <div class="blk"><h4>Metric definition (metrics store)</h4><div class="defrow">
    <span class="k">Semantic model</span><span>EW_Group_Sales_Finance</span>
    <span class="k">Measure</span><span>${m.sm}</span>
    <span class="k">Aggregation</span><span>${m.ag}</span>
    <span class="k">Time dimension</span><span>${m.tm}</span>
    <span class="k">Dimensions</span><span>${m.dm}</span>
    <span class="k">Type</span><span>${m.snap?"Snapshot (balance)":"Period (flow)"}</span>
  </div></div>
  <div class="blk"><h4>Calculation</h4><pre class="calc">${m.calc.replace(/&/g,"&amp;").replace(/</g,"&lt;")}</pre></div>
  <div class="blk"><h4>Source</h4><p>${m.src}</p></div>
  <div class="blk"><h4>Agentforce on this metric</h4><div class="act">
    <button class="actbtn" onclick="document.getElementById('mpI').innerHTML=inspectMetric('${id}','co')">Inspector: by company</button>
    <button class="actbtn" onclick="document.getElementById('mpI').innerHTML=inspectMetric('${id}','mgr')">Inspector: by manager</button>
    <button class="actbtn" onclick="document.getElementById('mpI').innerHTML=inspectMetric('${id}','rep')">Inspector: by salesperson</button>
   </div><div id="mpI"></div></div>
  <div class="blk"><h4>Related metrics</h4>${(m.rel||[]).filter(r=>MET[r]).map(r=>`<button class="relbtn" onclick="openMetric('${r}')">${MET[r].n} →</button>`).join("")}</div>`;
 $("mp").classList.add("open");$("mp").scrollTop=0;
}
