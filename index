function close_(i){$(i).classList.remove("open");}
/* Two licensed chat engines the CEO can use */
const ENGINES={
 concierge:{n:"Concierge",sub:"inside Tableau Next",
  note:"Concierge answers from the Tableau Semantics model, so every number matches the published metrics. Runs on your <b>Tableau Next</b> licences and is available to Consumer users, so the CEO can chat without a Creator seat. Admins can pre-approve Verified Questions so common answers never drift."},
 agentforce:{n:"CEO Assistant",sub:"Agentforce employee agent",
  note:"A custom employee agent you build in Agentforce Studio, grounded on the same metrics through <b>Einstein AI Skills</b> and <b>Prompt Templates</b>. Unlike Concierge it works anywhere in Salesforce and on mobile, can span objects beyond this dashboard, and can take action through Flows. Backed by your <b>Einstein Agent (601)</b>, <b>Agentforce Coworker (100,000)</b>, <b>Einstein AI Skills Manager (100,000)</b> and <b>Einstein Prompt Templates (100,000)</b> entitlements."}};
let CHAT_ENGINE="concierge";
let CHAT=[];
function setEngine(e){CHAT_ENGINE=e;CHAT=[];renderChat();}
function openConcierge(){
 $("sp").classList.add("open");
 if(!CHAT.length)renderChat();
}
function renderChat(){
 const E=ENGINES[CHAT_ENGINE];
 $("chatTitle").textContent=E.n+" \u00b7 "+E.sub;
 $("engRow").innerHTML=Object.keys(ENGINES).map(k=>
  `<button class="engbtn ${CHAT_ENGINE===k?"on":""}" onclick="setEngine('${k}')">${ENGINES[k].n}<span>${ENGINES[k].sub}</span></button>`).join("");
 $("engNote").innerHTML=E.note;
 if(!CHAT.length){
  const scope=(S.co==="all"?"all four companies":CO[S.co].name)+(S.rep!=="all"?" / "+S.rep:"")+" \u00b7 "+plb();
  CHAT=[{r:"sys",t:`${E.n} is reading the <b>EW_Group_Sales_Finance</b> model, scoped to <b>${scope}</b>. Change a filter on the dashboard and the answers follow.`}];
 }
 $("chatLog").innerHTML=CHAT.map(m=>{
  if(m.r==="me")return `<div class="bub me">${m.t}</div>`;
  if(m.r==="sys")return `<div class="bub sys">${m.t}</div>`;
  return `<div class="bub ai">${m.t}${m.src?`<span class="src">${m.src}</span>`:""}</div>`;
 }).join("");
 const asked=CHAT.filter(m=>m.r==="me").map(m=>m.t);
 const left=CQ.filter(q=>!asked.includes(q)).slice(0,3);
 $("chatSugg").innerHTML=left.map(q=>`<button class="chipq" onclick="askIt('${q.replace(/'/g,"")}')">${q}</button>`).join("");
 $("chatLog").scrollTop=999999;
}
function askIt(q){
 const question=q||$("ask").value||"Summarise performance";
 $("ask").value="";
 const a=conciergeAnswer(question,true);
 const src=CHAT_ENGINE==="concierge"?a.src:a.src.replace("Concierge","CEO Assistant (Agentforce)");
 CHAT.push({r:"me",t:question});
 CHAT.push({r:"ai",t:a.body,src:src});
 if(CHAT_ENGINE==="agentforce")
  CHAT.push({r:"sys",t:"The CEO Assistant can also act on this: run a Flow, draft a follow-up with a Prompt Template, or hand the item to an owner."});
 renderChat();
}
function toast(t,s){const e=$("toast");e.innerHTML=`<b>${t}</b><span class="s">${s}</span>`;e.classList.add("open");
 clearTimeout(window.__t);window.__t=setTimeout(()=>e.classList.remove("open"),4000);}
function ceoBrief(){
 const A=agg(),gp=A.actual*A.gm/100,arTot=A.ar.reduce((s,v)=>s+v,0);
 const r=Object.keys(CO).map(c=>({c,...coAgg(c)})).sort((a,b)=>b.att-a.att);
 $("mpN").textContent="CEO brief";
 $("mpS").textContent="Generated by an Einstein Prompt Template · "+plb();
 $("mpB").innerHTML=`<div class="blk"><h4>Generated narrative</h4><p>
  Group revenue is <b>${fA(A.actual)}</b>, ${pc(A.actual,A.target)}% of the ${fA(A.target)} target, up ${A.yoy.toFixed(1)}% on last year.
  All four companies are above plan, led by ${CO[r[0].c].name} at ${r[0].att}% and followed by ${r.slice(1).map(x=>CO[x.c].short+" "+x.att+"%").join(", ")}.
  Gross profit is ${fA(gp)} at a ${A.gm.toFixed(1)}% margin and EBITDA ${A.ebitda.toFixed(1)}%.
  Cash collection ran at ${Math.round(A.cash/A.actual*100)}% of billings, and only ${(A.ar[3]/arTot*100).toFixed(1)}% of the ${fA(arTot)} receivable book is beyond 90 days.
  Sales In of ${fA(A.salesIn)} against Sales Out of ${fA(A.salesOut)} adds ${fM(A.salesIn-A.salesOut)} to a backlog now worth ${fA(A.backlog)}.
  The month is forecast to land at <b>${fA(A.salesOut+A.pipeClose)}</b>.
  The largest remaining leak is <b>${fA(A.lb["Price did not match"])}</b> lost on price; with ${fA(A.lb["No Stock"])} lost to No Stock behind it, against a stock fill rate of ${A.fill.toFixed(0)}%.
 </p></div>
 <div class="blk"><h4>How this is produced</h4><p>An <b>Einstein Prompt Template</b> grounded on the published metrics, invoked by a Flow from the dashboard. You have 100,000 Prompt Template licences, so this is available today — unlike Tableau Next Dashboard Summaries, which are still Beta.</p></div>
 <div class="blk"><h4>Available actions</h4><div class="act">
   <button class="actbtn" onclick="close_('mp')">Back to dashboard</button>
   <button class="actbtn" onclick="toast('Brief scheduled','A Flow can run this prompt every weekday morning and email or post the brief.')">Schedule weekday brief</button>
 </div></div>`;
 $("mp").classList.add("open");$("mp").scrollTop=0;
}
function flow(n){toast("Flow launched","“"+n+"” runs a Salesforce Flow.");}
function setCo(c){S.co=c;if(c!=="all"){if(S.mgr!=="all"&&S.mgr!=="Not mapped"){const r=REPS.find(x=>x.mgr===S.mgr);if(r&&r.c!==c)S.mgr="all";}
 if(S.rep!=="all"){const r=REPS.find(x=>x.n===S.rep);if(r&&r.c!==c)S.rep="all";}}render();}
function togCo(c){setCo(S.co===c?"all":c);}
function setMgr(m){S.mgr=m;if(m!=="all"&&m!=="Not mapped"){const r=REPS.find(x=>x.mgr===m);if(r)S.co=r.c;}render();}
function togMgr(m){setMgr(S.mgr===m?"all":m);}
function setRep(r){S.rep=r;if(r!=="all"){const x=REPS.find(y=>y.n===r);if(x)S.co=x.c;}render();}
function togRep(r){setRep(S.rep===r?"all":r);}
$("pBtns").addEventListener("click",e=>{const b=e.target.closest?e.target.closest(".fbtn"):null;if(!b)return;
 document.querySelectorAll("#pBtns .fbtn").forEach(x=>x.classList.remove("on"));b.classList.add("on");S.p=b.dataset.p;render();});
$("coSel").addEventListener("change",e=>setCo(e.target.value));
$("mgrSel").addEventListener("change",e=>setMgr(e.target.value));
$("repSel").addEventListener("change",e=>setRep(e.target.value));
function setBr(b){
 S.br=b;
 if(b!=="all"){
  const cos=brandCos(b);
  /* a brand carried by one company only (DAB, DOORI, KSB, CALPAK -> Hydroway) scopes the page to it */
  if(cos.length===1&&S.co!==cos[0]){
   S.co=cos[0];
   if(S.mgr!=="all"&&S.mgr!=="Not mapped"&&mgrCo(S.mgr)!==S.co)S.mgr="all";
   if(S.rep!=="all"){const r=REPS.find(x=>x.n===S.rep);if(r&&r.c!==S.co)S.rep="all";}
  }
  /* drop a salesperson who does not carry the selected brand */
  if(S.rep!=="all"){const r=REPS.find(x=>x.n===S.rep);if(r&&r.brands&&!r.brands.includes(b))S.rep="all";}
 }
 render();
}
$("brSel").addEventListener("change",e=>setBr(e.target.value));
render();
</script>
