<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EW Group CEO Command Centre — Tableau Next</title>
<style>
  :root{
    --sf-blue:#0176D3; --sf-blue-d:#014486; --sf-navy:#032D60;
    --bg:#F3F3F3; --card:#FFFFFF; --line:#C9C9C9; --line2:#E5E5E5;
    --tx:#181818; --tx2:#444; --tx3:#747474;
    --green:#2E844A; --green-bg:#EEF7F1;
    --red:#BA0517; --red-bg:#FEF1F2;
    --amber:#A86403; --amber-bg:#FEF6E6;
    --teal:#06A59A; --purple:#9050E9; --orange:#D83A00;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:"Salesforce Sans","Helvetica Neue",Arial,sans-serif;background:var(--bg);color:var(--tx);font-size:13px;}
  .mv,.num,td.r{font-variant-numeric:tabular-nums;}

  .topbar{position:sticky;top:0;z-index:60;border-bottom:1px solid var(--line);box-shadow:0 1px 3px rgba(0,0,0,.06);}
  .sfhdr{background:var(--sf-navy);color:#fff;display:flex;align-items:center;gap:12px;padding:8px 16px;}
  .sfhdr .app{font-weight:700;font-size:14px;display:flex;align-items:center;gap:8px;}
  .sfhdr .app .sq{display:inline-grid;grid-template-columns:repeat(2,6px);grid-template-rows:repeat(2,6px);gap:2px;}
  .sfhdr .app .sq i{background:#1B96FF;} .sfhdr .app .sq i:nth-child(2){background:#FE9339;} .sfhdr .app .sq i:nth-child(3){background:#04E1CB;}
  .sfhdr .crumb{font-size:12px;color:#B8C7DA;} .sfhdr .crumb b{color:#fff;}
  .sfhdr .right{margin-left:auto;display:flex;gap:8px;}
  .sfbtn{background:#fff;border:1px solid var(--line);color:var(--sf-blue);padding:5px 12px;border-radius:4px;font-size:12px;cursor:pointer;font-family:inherit;font-weight:600;}
  .sfbtn:hover{background:#F3F8FE;}
  .sfbtn.ghost{background:transparent;border-color:#4A6A94;color:#fff;} .sfbtn.ghost:hover{background:#0B3A6B;}
  .sfbtn.brand{background:var(--sf-blue);border-color:var(--sf-blue);color:#fff;} .sfbtn.brand:hover{background:var(--sf-blue-d);}

  .assetbar{background:#FAFBFC;border-bottom:1px solid var(--line2);padding:9px 16px;display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--tx3);}
  .assetbar b{color:var(--tx2);}

  .filters{background:#fff;padding:10px 16px;display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;}
  .fw{display:flex;flex-direction:column;gap:3px;}
  .fw label{font-size:10.5px;color:var(--tx3);font-weight:600;}
  .fw select{padding:5px 8px;font-size:12px;border:1px solid var(--line);border-radius:4px;background:#fff;min-width:170px;font-family:inherit;cursor:pointer;}
  .fbtns{display:flex;gap:5px;}
  .fbtn{padding:5px 12px;font-size:12px;border:1px solid var(--line);border-radius:4px;background:#fff;color:var(--sf-blue);cursor:pointer;font-family:inherit;font-weight:600;}
  .fbtn.on{background:var(--sf-blue);border-color:var(--sf-blue);color:#fff;}

  .wrap{max-width:1340px;margin:0 auto;padding:14px 16px 44px;}
  .grid{display:grid;gap:12px;margin-bottom:12px;}
  .g4{grid-template-columns:repeat(4,1fr);}
  .g3{grid-template-columns:repeat(3,1fr);}
  .g2{grid-template-columns:repeat(2,1fr);}
  .g23{grid-template-columns:2fr 1fr;}

  /* text widget */
  .txt{background:#fff;border:1px solid var(--line2);border-radius:8px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;line-height:1.6;color:var(--tx2);}
  .txt b{color:var(--tx);}
  .sect{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--tx3);margin:16px 2px 9px;}

  /* metric widget — Tableau Next metric card: name, value, comparison vs prior period, trend */
  .m{background:#fff;border:1px solid var(--line2);border-radius:8px;padding:13px 14px;cursor:pointer;}
  .m:hover{border-color:var(--sf-blue);}
  .m .mn{font-size:12px;color:var(--tx2);font-weight:600;}
  .m .mn .snap{font-size:9.5px;background:#F3F3F3;border:1px solid var(--line2);border-radius:3px;padding:0 5px;color:var(--tx3);margin-left:5px;font-weight:700;}
  .m .mv{font-size:24px;font-weight:700;margin-top:6px;line-height:1.1;}
  .m .mc{font-size:11.5px;margin-top:4px;color:var(--tx3);}
  .m .spark{margin-top:8px;display:block;}
  .up{color:var(--green);font-weight:700;} .down{color:var(--red);font-weight:700;} .flat{color:var(--tx3);font-weight:700;}
  .cf-g{color:var(--green);} .cf-a{color:var(--amber);} .cf-r{color:var(--red);}

  .w{background:#fff;border:1px solid var(--line2);border-radius:8px;}
  .w .wh{padding:10px 14px;border-bottom:1px solid var(--line2);display:flex;align-items:center;gap:8px;}
  .w .wh h3{font-size:13px;font-weight:700;}
  .w .wh .sub{font-size:11px;color:var(--tx3);font-weight:400;}
  .w .wh .go{margin-left:auto;font-size:11px;color:var(--sf-blue);cursor:pointer;font-weight:600;}
  .w .wh .go:hover{text-decoration:underline;}
  .w .wh .kind{margin-left:8px;font-size:10px;color:var(--tx3);background:#F3F3F3;border:1px solid var(--line2);border-radius:3px;padding:1px 6px;font-weight:600;}
  .w .wb{padding:13px 14px;}
  .w .wb.tbl{padding:0;overflow-x:auto;}
  .w .wb.tbl table{min-width:760px;}
  .grid{align-items:stretch;}
  .m{display:flex;flex-direction:column;}
  .m .mfill{flex:1;}
  .m .spark{margin-top:auto;padding-top:7px;}

  .hb{display:grid;grid-template-columns:120px 1fr 62px;align-items:center;gap:9px;margin-bottom:7px;font-size:12px;}
  .hb .lb{color:var(--tx2);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .hb .tr{background:#EDEDED;height:15px;overflow:hidden;position:relative;}
  .hb .tr i{display:block;height:100%;background:var(--sf-blue);}
  .hb .vl{font-weight:700;text-align:right;}

  table{width:100%;border-collapse:collapse;font-size:12px;}
  th{text-align:left;font-size:10.5px;text-transform:uppercase;color:var(--tx3);font-weight:700;padding:7px 9px;border-bottom:1px solid var(--line);background:#FAFAFA;}
  td{padding:7px 9px;border-bottom:1px solid var(--line2);}
  tr:last-child td{border-bottom:none;}
  td.r,th.r{text-align:right;}
  tbody tr.click{cursor:pointer;} tbody tr.click:hover td{background:#F3F8FE;}
  tr.sel td{background:#EEF4FF;}
  .cg{background:var(--green-bg);color:var(--green);font-weight:700;}
  .ca{background:var(--amber-bg);color:var(--amber);font-weight:700;}
  .cr{background:var(--red-bg);color:var(--red);font-weight:700;}
  .chip{display:inline-block;padding:1px 7px;border-radius:10px;font-size:10.5px;font-weight:700;}
  .lnk{color:var(--sf-blue);font-weight:600;cursor:pointer;}

  .act{display:flex;gap:9px;flex-wrap:wrap;}
  .actbtn{background:#fff;border:1px solid var(--sf-blue);color:var(--sf-blue);border-radius:4px;padding:7px 12px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;}
  .actbtn:hover{background:#F3F8FE;}
  .note{font-size:11px;color:var(--tx3);margin-top:9px;line-height:1.55;}
  .legend{display:flex;gap:14px;font-size:11.5px;color:var(--tx2);margin-bottom:8px;flex-wrap:wrap;}
  .legend i{display:inline-block;width:10px;height:10px;margin-right:5px;}

  /* panels (side panel = Concierge; page = metric detail / definitions dashboard) */
  .pg{display:none;position:fixed;inset:0;background:var(--bg);z-index:80;overflow:auto;}
  .pg.open{display:block;}
  .pgbar{background:#fff;border-bottom:1px solid var(--line);padding:10px 16px;display:flex;align-items:center;gap:12px;position:sticky;top:0;}
  .pgbar .nm{font-size:14px;font-weight:700;}
  .pgbar .sc{margin-left:auto;font-size:11.5px;color:var(--tx3);}
  .pgwrap{max-width:1060px;margin:0 auto;padding:14px 16px 44px;}
  .blk{background:#fff;border:1px solid var(--line2);border-radius:8px;padding:13px 15px;margin-bottom:10px;}
  .blk h4{font-size:11px;text-transform:uppercase;color:var(--tx3);font-weight:700;margin-bottom:7px;}
  .blk p{font-size:12.5px;line-height:1.65;color:var(--tx2);}
  .defrow{display:grid;grid-template-columns:180px 1fr;gap:6px 14px;font-size:12.5px;}
  .defrow .k{color:var(--tx3);font-weight:600;}
  pre.calc{background:#F7F9FB;border:1px solid var(--line2);border-left:3px solid var(--sf-blue);padding:11px 13px;font-family:Consolas,monospace;font-size:11.5px;line-height:1.6;color:#032D60;overflow-x:auto;white-space:pre;}
  .hero{background:#fff;border:1px solid var(--line2);border-radius:8px;padding:16px 18px;margin-bottom:12px;display:flex;gap:30px;align-items:flex-end;flex-wrap:wrap;}
  .hero .big{font-size:32px;font-weight:700;line-height:1;}
  .hero .lab{font-size:10.5px;color:var(--tx3);font-weight:600;margin-bottom:4px;}
  .hero .side{font-size:15px;font-weight:700;color:var(--tx2);}
  .warn{background:var(--amber-bg);border:1px solid #F5D9A0;border-radius:6px;padding:9px 12px;font-size:12px;color:#6B4200;margin-bottom:10px;}
  .relbtn{background:#fff;border:1px solid var(--line);color:var(--sf-blue);border-radius:4px;padding:5px 10px;font-size:11.5px;cursor:pointer;margin:3px 5px 0 0;font-family:inherit;font-weight:600;}

  .sp{display:none;position:fixed;top:0;right:0;bottom:0;width:400px;background:#fff;border-left:1px solid var(--line);box-shadow:-3px 0 14px rgba(0,0,0,.12);z-index:90;overflow:auto;}
  .sp.open{display:block;}
  .sph{padding:12px 15px;border-bottom:1px solid var(--line2);display:flex;align-items:center;gap:8px;}
  .sph h3{font-size:13px;font-weight:700;}
  .spb{padding:13px 15px;}
  .cx{background:#F8F9FB;border:1px solid var(--line2);border-radius:6px;padding:10px 12px;margin-bottom:9px;font-size:12px;}
  .cx .q{font-weight:700;color:var(--sf-blue-d);margin-bottom:4px;}
  .cx .a{color:var(--tx2);line-height:1.6;}
  .askrow{display:flex;gap:7px;margin-top:10px;}
  .askrow input{flex:1;padding:7px 9px;border:1px solid var(--line);border-radius:4px;font-size:12px;font-family:inherit;}
  .toast{display:none;position:fixed;bottom:18px;left:50%;margin-left:-200px;width:400px;background:#fff;border:1px solid var(--line);border-left:4px solid var(--green);border-radius:6px;padding:11px 14px;font-size:12px;box-shadow:0 4px 14px rgba(0,0,0,.16);z-index:100;}
  .toast.open{display:block;} .toast b{display:block;margin-bottom:2px;} .toast .s{color:var(--tx3);font-size:11px;}

  @media(max-width:1000px){.g4{grid-template-columns:1fr 1fr;}.g3,.g23{grid-template-columns:1fr;}.sp{width:100%;}}
  @media(max-width:620px){.g4,.g2{grid-template-columns:1fr;}.topbar{position:static;}}

  /* Agentforce */
  .af{background:#fff;border:1px solid #D5DAFB;border-radius:8px;}
  .af .wh{padding:10px 14px;border-bottom:1px solid #E6E9FD;display:flex;align-items:center;gap:8px;}
  .af .wh h3{font-size:13px;font-weight:700;color:#3D3FA8;}
  .af .wh .sub{font-size:11px;color:var(--tx3);font-weight:400;}
  .af .wh .kind{margin-left:auto;font-size:10px;color:#5867E8;background:#EEF0FE;border:1px solid #D5DAFB;border-radius:3px;padding:1px 6px;font-weight:700;}
  .af .wb{padding:13px 14px;}
  .chipq{display:inline-block;background:#F6F7FF;border:1px solid #D5DAFB;color:#3D3FA8;border-radius:14px;padding:5px 11px;font-size:11.5px;font-weight:600;cursor:pointer;margin:0 6px 6px 0;font-family:inherit;}
  .chipq:hover{background:#E8EBFE;}
  .ansbox{background:#F8F9FB;border:1px solid var(--line2);border-left:3px solid #5867E8;border-radius:5px;padding:11px 13px;font-size:12.5px;line-height:1.65;color:var(--tx2);margin-top:10px;}
  .ansbox b{color:var(--tx);}
  .ansbox .src{display:block;margin-top:7px;font-size:10.5px;color:var(--tx3);}
  .beta{background:#EEF0FE;color:#5867E8;border:1px solid #D5DAFB;border-radius:3px;padding:0 5px;font-size:9.5px;font-weight:700;margin-left:5px;vertical-align:1px;}
  .rank{display:grid;grid-template-columns:150px 1fr 74px;align-items:center;gap:9px;margin-bottom:6px;font-size:12px;}
  .rank .lb{color:var(--tx2);text-align:right;}
  .rank .tr{background:#EDEDED;height:14px;}
  .rank .tr i{display:block;height:100%;background:#5867E8;}
  .rank .vl{font-weight:700;text-align:right;}
  .skillrow{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--line2);font-size:12px;}
  .skillrow:last-child{border-bottom:none;}
  .skillrow .ic{width:26px;height:26px;border-radius:5px;background:#EEF0FE;color:#5867E8;display:flex;align-items:center;justify-content:center;font-weight:700;flex:none;}
  .skillrow .nm{font-weight:700;}
  .skillrow .ds{color:var(--tx3);font-size:11.5px;margin-top:1px;}

  /* CEO chat — Concierge in Tableau Next, or an Agentforce employee agent */
  .chatfab{position:fixed;bottom:22px;right:22px;z-index:95;background:var(--sf-blue);color:#fff;border:none;
    border-radius:26px;padding:12px 20px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;
    box-shadow:0 3px 12px rgba(1,118,211,.35);display:flex;align-items:center;gap:8px;}
  .chatfab:hover{background:var(--sf-blue-d);}
  .chatfab .dot{width:8px;height:8px;border-radius:50%;background:#7CE7C1;}
  .sp{width:440px;}
  .chatwrap{display:flex;flex-direction:column;height:calc(100vh - 54px);}
  .chatlog{flex:1;overflow-y:auto;padding:13px 15px;background:#FAFBFC;}
  .bub{max-width:86%;margin-bottom:11px;font-size:12.5px;line-height:1.6;}
  .bub.me{margin-left:auto;background:var(--sf-blue);color:#fff;border-radius:12px 12px 3px 12px;padding:9px 12px;}
  .bub.ai{background:#fff;border:1px solid var(--line2);border-radius:12px 12px 12px 3px;padding:11px 13px;color:var(--tx2);}
  .bub.ai b{color:var(--tx);}
  .bub.ai .src{display:block;margin-top:7px;font-size:10.5px;color:var(--tx3);}
  .bub.sys{background:#EEF4FF;border:1px solid #CFE2FF;border-radius:8px;padding:9px 12px;color:var(--sf-blue-d);font-size:11.5px;max-width:100%;}
  .chatin{border-top:1px solid var(--line2);padding:11px 15px;background:#fff;}
  .chatin .row{display:flex;gap:7px;}
  .chatin input{flex:1;padding:9px 11px;border:1px solid var(--line);border-radius:18px;font-size:12.5px;font-family:inherit;}
  .sugg{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:9px;}
  .eng{display:flex;gap:6px;margin-bottom:10px;}
  .engbtn{flex:1;border:1px solid var(--line);background:#fff;border-radius:6px;padding:7px 9px;font-size:11px;cursor:pointer;font-family:inherit;text-align:left;color:var(--tx2);}
  .engbtn.on{border-color:var(--sf-blue);background:#F3F8FE;color:var(--sf-blue-d);font-weight:700;}
  .engbtn span{display:block;font-size:10px;color:var(--tx3);font-weight:400;margin-top:1px;}
</style></head>
<body>

<div class="topbar">
<div class="sfhdr">
  <span class="app"><span class="sq"><i></i><i></i><i></i><i></i></span> Tableau Next</span>
  <span class="crumb">Workspace: EW Group Analytics / Dashboards / <b>Group CEO Command Centre</b></span>
  <span class="right">
    <button class="sfbtn ghost" onclick="openConcierge()">Ask Concierge</button>
    <button class="sfbtn ghost" onclick="toast('Share dashboard','Shared with Tableau Next Consumer users in the EW Group Analytics workspace. Slack delivery is not enabled on your licences.')">Share</button>
    <button class="sfbtn ghost" onclick="openDefs()">Metric definitions</button>
  </span>
</div>

<div class="assetbar">
  <span><b>Semantic model:</b> EW_Group_Sales_Finance</span>
  <span><b>Data:</b> Data 360 — Salesforce (zero-copy) + Navision for GL/stock</span>
  <span><b>Metrics:</b> 33 published</span>
  <span><b>Refreshed:</b> today 6:00 AM</span>
  <span id="scopeLbl"></span>
</div>

<div class="filters">
  <div class="fw"><label>Period</label>
    <div class="fbtns" id="pBtns">
      <button class="fbtn" data-p="today">Today</button>
      <button class="fbtn on" data-p="mtd">MTD</button>
      <button class="fbtn" data-p="qtd">QTD</button>
      <button class="fbtn" data-p="ytd">YTD</button>
    </div>
  </div>
  <div class="fw"><label>Company</label>
    <select id="coSel">
      <option value="all">All Companies</option>
      <option value="EW">Electric Way — Dubai</option>
      <option value="EWA">Electric Way Arabia — KSA</option>
      <option value="HYD">Hydroway — Deira</option>
      <option value="TRZ">Traderz — Deira</option>
    </select>
  </div>
  <div class="fw"><label>Sales Manager</label><select id="mgrSel"></select></div>
  <div class="fw"><label>Salesperson</label><select id="repSel"></select></div>
  <div class="fw"><label>Brand</label><select id="brSel"></select></div>
</div>
</div>

<div class="wrap">


  <div class="sect">Performance</div>
  <div class="grid g4" id="r1"></div>
  <div class="sect">Sales efficiency</div>
  <div class="grid g4" id="r3"></div>
  <div class="sect">Working capital, service &amp; risk</div>
  <div class="grid g4" id="r4"></div>

  <div class="sect">Forecasting, Sales In &amp; Sales Out</div>
  <div class="grid g4" id="r7"></div>
  <div class="grid g2">
    <div class="w">
      <div class="wh"><h3>Sales In vs Sales Out</h3><span class="sub">orders received vs invoiced, AED M</span><span class="go" onclick="openMetric('salesin')">Open metric →</span><span class="kind">VIZ · LINE</span></div>
      <div class="wb"><div class="legend"><span><i style="background:#0176D3"></i>Sales In (Order)</span><span><i style="background:#2E844A"></i>Sales Out (Invoice)</span></div><svg id="sioSvg" viewBox="0 0 560 170" width="100%" style="cursor:pointer" onclick="openMetric('salesin')"></svg><div class="note" id="sioNote"></div></div>
    </div>
    <div class="w">
      <div class="wh"><h3>Month-end forecast vs target</h3><span class="sub" id="fcSub"></span><span class="go" onclick="openMetric('forecast')">Open metric →</span><span class="kind">VIZ · BAR</span></div>
      <div class="wb" id="fcViz"></div>
    </div>
  </div>

  <div class="sect">Projects &amp; incentive</div>
  <div class="grid g4" id="r6"></div>

  <div class="sect">Traderz — trading counter activity</div>
  <div class="grid g4" id="r5"></div>

  <div class="sect">Agentforce</div>
  <div class="grid g3">
    <div class="af">
      <div class="wh"><h3>Concierge</h3><span class="sub">ask the semantic model</span><span class="kind">SKILL · GA</span></div>
      <div class="wb">
        <div id="cqChips"></div>
        <div class="askrow"><input id="askMain" placeholder="Ask your own question" onkeydown="if(event.key==='Enter')conciergeAsk()"><button class="sfbtn brand" onclick="conciergeAsk()">Ask</button></div>
        <div class="act" style="margin-top:9px"><button class="actbtn" onclick="openConcierge()">Open full chat</button></div>
        <div id="cqAns"></div>
      </div>
    </div>
    <div class="af">
      <div class="wh"><h3>Inspector</h3><span class="sub">analyse what moved a metric</span><span class="kind">SKILL · GA</span></div>
      <div class="wb">
        <div style="display:flex;gap:7px">
          <select id="inspSel" style="flex:1;padding:5px 8px;font-size:12px;border:1px solid var(--line);border-radius:4px;font-family:inherit"></select>
          <select id="inspDim" style="width:132px;padding:5px 8px;font-size:12px;border:1px solid var(--line);border-radius:4px;font-family:inherit">
            <option value="co">by Company</option>
            <option value="mgr">by Manager</option>
            <option value="rep">by Salesperson</option>
          </select>
        </div>
        <button class="sfbtn brand" style="margin-top:8px" onclick="inspectRun()">Analyse metric</button>
        <div id="inspAns"></div>
        <div class="note">On-demand analysis is available now. <b>Proactive alerts</b> pushed to Slack are <span class="beta">BETA</span>.</div>
      </div>
    </div>
    <div class="af">
      <div class="wh"><h3>Data Pro</h3><span class="sub">semantic modelling assistance</span><span class="kind">SKILL · GA</span></div>
      <div class="wb"><div id="dpChips"></div><div id="dpAns"></div>
        <div class="note">Data Pro assists the Creator building the model, not the CEO reading it.</div>
        <div class="act" style="margin-top:10px"><button class="actbtn" onclick="openCaps()">See all 10 licensed Agentforce features</button></div></div>
    </div>
  </div>

  <div class="sect">Vizzes</div>
  <div class="grid g23">
    <div class="w">
      <div class="wh"><h3>Revenue by month and company</h3><span class="sub">AED M</span><span class="go" onclick="openMetric('rev')">Open metric →</span><span class="kind">VIZ · STACKED BAR</span></div>
      <div class="wb"><div class="legend" id="lgd"></div><svg id="trend" viewBox="0 0 560 180" width="100%" style="cursor:pointer" onclick="openMetric('rev')"></svg></div>
