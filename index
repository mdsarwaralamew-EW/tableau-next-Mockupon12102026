function inspectMetric(id,dim){
 const m=MET[id],C=CONTRIB[id];dim=dim||"co";
 if(!C)return `<div class="ansbox">No breakdown configured for ${m.n}.</div>`;
 let rows=[];
 if(dim==="co") rows=keys().map(c=>({k:CO[c].name,v:C.f(c)}));
 else if(dim==="mgr"){
  if(!C.add) return `<div class="ansbox">${m.n} is a rate, so a manager-level split needs the underlying counts rather than a weighted average. Analyse it by Company, or use Revenue / Open Pipeline / AR by Manager instead.<span class="src">Inspector</span></div>`;
  rows=MGRS.filter(mg=>keys().includes(REPS.find(x=>x.mgr===mg).c)).map(mg=>{
   const R=REPS.filter(x=>x.mgr===mg);
   const cv=C.f(R[0].c),ct=REPS.filter(x=>x.c===R[0].c).reduce((s,x)=>s+x.t,0);
   return {k:mg,v:cv*R.reduce((s,x)=>s+x.t,0)/ct};});
 } else {
  if(!C.add) return `<div class="ansbox">${m.n} is a rate and is not attributed per salesperson in the model. Analyse by Company, or pick Revenue, Open Pipeline or Calls for a salesperson split.<span class="src">Inspector</span></div>`;
  rows=reps().map(r=>{const cv=C.f(r.c),ct=REPS.filter(x=>x.c===r.c).reduce((s,x)=>s+x.t,0);
   return {k:r.n,v:id==="calls"?(r.calls||0)*k():id==="visits"?(r.visits||0)*k():id==="rev"?r.a*k()
     :id==="incentive"?incentiveOf(r)*k():cv*r.t/ct};});
 }
 rows=rows.filter(r=>r.v>0).sort((a,b)=>b.v-a.v).slice(0,8);
 if(!rows.length)return `<div class="ansbox">No data for ${m.n} in this selection.<span class="src">Inspector</span></div>`;
 const tot=rows.reduce((s,x)=>s+x.v,0),mx=Math.max(...rows.map(x=>x.v))||1;
 const bars=rows.map(x=>`<div class="rank"><span class="lb">${x.k}</span><span class="tr"><i style="width:${x.v/mx*100}%"></i></span><b class="vl">${C.fmt(x.v)}</b></div>`).join("");
 let verdict;
 if(C.add){const top=rows[0];
  verdict=`<b>${top.k} is the largest contributor</b> at ${C.fmt(top.v)}, ${Math.round(top.v/tot*100)}% of the ${C.fmt(tot)} shown.`;
 } else {const best=C.hi?rows[0]:rows[rows.length-1],worst=C.hi?rows[rows.length-1]:rows[0];
  verdict=`<b>${worst.k} is weakest at ${C.fmt(worst.v)}</b>, against ${best.k} at ${C.fmt(best.v)}.`;}
 const A=agg();let corr="";
 if(id==="fill"||id==="inventory")corr=`Related: ${fA(A.lb["No Stock"]||0)} lost to No Stock this ${plb()}, consistent with fill rate at ${A.fill.toFixed(0)}%.`;
 else if(id==="ar90"||id==="dso")corr=`Related: collections were ${Math.round(A.cash/A.actual*100)}% of billings and ${fA(A.ar[3])} sits beyond 90 days.`;
 else if(id==="gp"||id==="ebitda")corr=`Related: ${fA(A.lb["Price did not match"]||0)} lost on price this ${plb()}, the largest loss reason.`;
 else if(id==="openpipe")corr=`Related: total not-closed value is ${fA(A.allPipe)}; the difference sits in stages each company excludes from Open Pipeline.`;
 else if(id==="calls"||id==="visits")corr=`Related: Traderz planner adherence is ${ACT.planner}% against a ${ACT.plannerT}% target.`;
 const dimLbl=dim==="co"?"Company":dim==="mgr"?"Sales Manager":"Salesperson";
 return `<div class="ansbox">${verdict}<div style="margin-top:10px">${bars}</div>${corr?`<div style="margin-top:8px">${corr}</div>`:""}
  <span class="src">Inspector · ${m.n} by ${dimLbl} · scope ${S.co==="all"?"all companies":CO[S.co].name}, ${plb()}${m.snap?" · snapshot":""}</span></div>`;
}
